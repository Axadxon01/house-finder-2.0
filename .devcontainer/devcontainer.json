{
  "name": "House Finder Pro",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {"openFiles": ["README.md", "app.py"]},
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && echo '✅ Packages installed'",
  "postAttachCommand": {"server": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false"},
  "portsAttributes": {"8501": {"label": "House Finder Pro", "onAutoForward": "openPreview"}},
  "forwardPorts": [8501]
}
